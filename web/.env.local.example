# Next.js: 로컬 개발용. 이 파일을 복사해 .env.local 로 저장하고 값을 채운다.
# cp .env.local.example .env.local

# NEXT_PUBLIC_APP_NAME=식사분석AI

# --- AI로 음식명 자동 추출 (선택) ---
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_DISABLED=true
#
# --- Gemini(구글) 키로 추출 (override.ts에서 사용) ---
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-2.0-flash

# --- 나이스 교육정보 개방 포털 (학교 급식) ---
# https://open.neis.go.kr/ 에서 인증키 발급
# NEIS_API_KEY=your-neis-key
